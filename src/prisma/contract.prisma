// use prisma-8

enum Departamento {
  @@type("pg/text@1")
  CHEFIA_GABINETE = "Chefia de Gabinete"
  SEC_GOVERNO_PLANEJAMENTO = "Secretaria Municipal Governo e Planejamento Estratégico"
  SEC_ASSUNTOS_JURIDICOS = "Secretaria Municipal de Assuntos Jurídicos"
  SEC_ADMINISTRACAO = "Secretaria Municipal Administração, Gestão e Equipe Públicos"
  SEC_FAZENDA = "Secretaria Municipal Fazenda, Desenvolvimento Econômico e Finanças"
  SEC_TURISMO = "Secretaria Municipal Turismo, Juventude e Empreendedorismo"
  SEC_OBRAS_PUBLICAS = "Secretaria Municipal Obras Públicas"
  SEC_PLANEJAMENTO_URBANO = "Secretaria Municipal Planejamento Urbano e Habitação"
}

enum Sala {
  @@type("pg/text@1")
  SALA_1 = "Sala Azul"
  SALA_2 = "Sala Verde"
  SALA_3 = "Sala Amarela"
}

// `PREFEITO` é a "Prioridade 0" da issue #66: permite sobrepor uma reserva já
// existente, desde que o papel do usuário e a sala autorizem (regra no endpoint).
enum Prioridade {
  @@type("pg/text@1")
  NORMAL
  PREFEITO
}

model Agendamento {
  id           String       @id @default(uuid())
  nome         String
  departamento Departamento
  sala         Sala
  data         DateString
  horaInicio   VarChar(5)
  horaFim      VarChar(5)
  criadoEm     TimestamptzString @default(now())
  prioridade   Prioridade   @default(NORMAL)

  // `prioridade` entra na chave para que uma reserva NORMAL e uma PREFEITO
  // possam coexistir no mesmo horário (a sobreposição controlada da issue #66).
  // Duplicatas da mesma prioridade continuam bloqueadas no banco.
  @@unique([sala, data, horaInicio, prioridade])
}