# Copie este arquivo para `.env` e ajuste os valores conforme necessário.

# ---------------------------------------------------------------------------
# Banco local opcional para desenvolvimento (Postgres >= 15).
# Se usar `docker compose up -d postgres`, descomente esta DATABASE_URL.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda"

# Credenciais do PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda

# ---------------------------------------------------------------------------
# Neon (banco padrão; Connection Details no painel do Neon)
# Substitua pelos valores do painel do Neon
# (Connection Details > Connection string).
#
# DATABASE_URL: string **com** `-pooler`, usada pela aplicação em runtime.
# DIRECT_URL:   string **sem** `-pooler`, usada pela CLI (migrations/DDL).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Porta de entrada (senha compartilhada do grupo)
#
# Em desenvolvimento o acesso é aberto sem esta variável — `npm run dev` e o
# Cypress não precisam de login. Preencha para exercitar a tela `/entrar`
# localmente. Em produção (Vercel ou Docker) ela é obrigatória: sem senha o
# acesso fica fechado.
# ---------------------------------------------------------------------------
# ACCESS_PASSWORD="senha-do-grupo"

# Segredo aleatório para proteger a rota de retenção. Necessário na Vercel.
# CRON_SECRET="gere-um-segredo-longo-e-aleatorio"
