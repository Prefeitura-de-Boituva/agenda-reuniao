# Copie este arquivo para `.env` e ajuste os valores conforme necessário.

# ---------------------------------------------------------------------------
# Opção 1 — PostgreSQL local (docker-compose ou instalado na máquina)
# Requer PostgreSQL >= 15.
# No docker-compose, a DATABASE_URL do serviço `app` é montada automaticamente
# a partir de POSTGRES_USER, POSTGRES_PASSWORD e POSTGRES_DB abaixo.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda"

# Credenciais do PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda

# ---------------------------------------------------------------------------
# Opção 2 — Neon (produção)
# Descomente e substitua pelos valores do painel do Neon
# (Connection Details > Connection string).
#
# DATABASE_URL: string **com** `-pooler`, usada pela aplicação em runtime.
# DIRECT_URL:   string **sem** `-pooler`, usada pela CLI (migrations/DDL).
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"
