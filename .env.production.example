# Referência para o `.env.production.local` do deploy local com Docker + Neon.
# Copie para `.env.production.local` e preencha os valores reais:
#   cp .env.production.example .env.production.local
#   chmod 600 .env.production.local
#
# O `docker compose` carrega este arquivo via `--env-file`.
# Nunca versione o `.env.production.local`.
#
# Antes do primeiro deploy, rotacione a senha do role do Neon se ela tiver
# sido exposta e atualize as connection strings abaixo.

# Runtime da aplicação — connection string **pooled** do Neon (host `-pooler`).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Usada apenas pela CLI do Prisma (migrations/DDL), executada a partir do
# repositório. Não é consumida pelo container.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Senha compartilhada do grupo (portaria de entrada em `/entrar`). Obrigatória:
# em produção o acesso fica fechado sem ela. Trocar o valor invalida os cookies
# já emitidos — todos precisam entrar de novo.
ACCESS_PASSWORD="troque-por-uma-senha-do-grupo"

# Porta publicada no host para acessar a aplicação em http://localhost:<porta>.
# Se 3001 estiver ocupada, use 3002.
APP_PORT=3001

# Tag da imagem local. Prefira o commit para permitir rollback:
#   export TAG=$(git rev-parse --short HEAD)
#   docker compose -f docker-compose.prod.yml --env-file .env.production.local up -d --build
TAG=latest
