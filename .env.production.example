# Referência para o `.env` do servidor de produção.
# Copie para `.env` **no servidor** e preencha os valores reais:
#   cp .env.production.example .env
#   chmod 600 .env
#
# O `docker compose` carrega o `.env` do diretório do projeto automaticamente.
# Nunca versione o `.env` real.

# Runtime da aplicação — connection string **pooled** do Neon (host `-pooler`).
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Usada apenas pela CLI do Prisma (migrations/DDL), executada a partir do
# repositório. Não é consumida pelo container.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Tag da imagem local. Use o commit para permitir rollback:
#   TAG=8ec948b docker compose -f docker-compose.prod.yml up -d --build
TAG=latest
