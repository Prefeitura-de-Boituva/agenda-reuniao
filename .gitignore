# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs locais (não versionadas)
/docs
node_modules/
dist/
.env

# pastas e instruções de agentes de código (não fazem parte da aplicação)
/.agents/
/.claude/
/.cursor/
/.devin/
/AGENTS.md
/QODER.md

# arquivos temporários de comparação visual
/.tmp-*.png

.neon

# artefatos do Cypress (screenshotOnRunFailure)
/cypress/screenshots/
